# =============================================================================
# Desenvolvimento local (fora do Docker)
# =============================================================================
# Para produção na VPS, use: ./scripts/setup-production-env.sh
# =============================================================================

# PostgreSQL (usado pelo docker-compose e pelo setup de produção)
POSTGRES_DB=doqyn_auth
POSTGRES_USER=doqyn_auth
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

PORT=4100
NODE_ENV=development

# Local fora do Docker: localhost:5433
# Docker/produção API: pgbouncer:5432 | migrations: postgres-auth:5432
DATABASE_URL=postgresql://doqyn_auth:change-me@localhost:5433/doqyn_auth
# Em dev local, igual ao DATABASE_URL. Na VPS: conexão direta ao Postgres (migrations/Prisma directUrl).
DATABASE_URL_DIRECT=postgresql://doqyn_auth:change-me@localhost:5433/doqyn_auth

# Redis — rate limit distribuído (obrigatório antes de N réplicas do auth)
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
# Prefixo isolado — NÃO use o mesmo do Alpha se Redis for compartilhado
REDIS_KEY_PREFIX=doqyn:auth:
RATE_LIMIT_REDIS_ENABLED=true

# =============================================================================
# === SYNC Auth↔Alpha (P0) — no Alpha: npm run env:auth-sync ===
# Pares com doqyn-alpha-document-intelligence/.env (valores devem bater)
# =============================================================================
# Idêntico a Alpha.DOQYN_AUTH_COOKIE_NAME
SESSION_COOKIE_NAME=doqyn_session
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Deve incluir Alpha.DOQYN_PUBLIC_APP_URL (origem do frontend)
ALLOWED_ORIGINS=http://localhost:5173

# Idêntico a Alpha.DOQYN_AUTH_INTERNAL_API_KEY
DOQYN_INTERNAL_API_KEY=change-me
# URL da API Alpha (local :3001 | Docker http://doqyn-api:3001)
DOQYN_APP_BASE_URL=http://127.0.0.1:3001
# Idêntico a Alpha.DOQYN_APP_INTERNAL_API_KEY (≥24 chars em production; sem placeholder de example)
DOQYN_APP_INTERNAL_API_KEY=dev-app-internal-api-key-change-in-production

# Crypto só Auth (não espelhar no Alpha).
# Obrigatório: base64 de exatamente 32 bytes. Gere com: openssl rand -base64 32
# Abaixo: exemplo DEV (32 bytes zero) — NUNCA usar em produção / troque ao copiar .env
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOOKUP_HASH_SECRET=change-me
SESSION_TOKEN_HASH_SECRET=change-me
PASSWORD_RESET_TOKEN_HASH_SECRET=change-me
PASSWORD_PEPPER=optional-change-me

PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Convites de membros — idealmente igual a Alpha.DOQYN_PUBLIC_APP_URL
DOQYN_APP_PUBLIC_URL=http://localhost:5173
EMAIL_FROM=noreply@doqyn.com.br
EMAIL_ENABLED=false
INVITE_TTL_DAYS=7
EMAIL_CHANGE_ENABLED=false
EMAIL_CHANGE_TTL_HOURS=24

# SMTP global opcional (fallback de desenvolvimento; convites usam SMTP do tenant)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Apenas para seed de desenvolvimento (npm run db:seed)
SEED_DEV_PASSWORD=DevDoqyn@123
# Defina true apenas para sobrescrever passwordHash de usuários já existentes
# SEED_FORCE_PASSWORD_RESET=true

# Opcional: banco separado para testes (evita npm test apagar dados de dev)
# TEST_DATABASE_URL=postgresql://doqyn_auth:change-me@localhost:5433/doqyn_auth_test

# OAuth / OpenID Connect (Google e Microsoft)
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/oauth/google/callback

OAUTH_MICROSOFT_ENABLED=true
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_MICROSOFT_REDIRECT_URI=http://127.0.0.1:4100/oauth/microsoft/callback

OAUTH_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth/oauth/callback
OAUTH_ERROR_REDIRECT_URL=http://localhost:5173/login
