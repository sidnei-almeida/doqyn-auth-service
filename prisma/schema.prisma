generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

enum AuthUserStatus {
  active
  disabled
  pending_verification
  anonymized
}

enum TenantStatus {
  pending
  pending_provisioning
  provisioning_failed
  active
  blocked
}

enum TenantType {
  individual
  business
}

enum MembershipStatus {
  pending
  active
  blocked
  rejected
  removed
}

enum AccessGroupStatus {
  active
  inactive
  deleted
}

enum TenantRole {
  company_admin
  individual_admin
  user
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum TermsAcceptanceFlow {
  company_registration
  access_request
  individual_registration
  reacceptance
  invite_accept
}

model AuthUser {
  id                    String         @id @default(uuid()) @db.Uuid
  emailEncrypted        String         @map("email_encrypted")
  emailLookupHash       String         @unique @map("email_lookup_hash")
  firstNameEncrypted    String?        @map("first_name_encrypted")
  lastNameEncrypted     String?        @map("last_name_encrypted")
  whatsappEncrypted     String?        @map("whatsapp_encrypted")
  whatsappLookupHash    String?        @map("whatsapp_lookup_hash")
  /// O apelido público, e a única coluna de identidade em texto claro.
  ///
  /// Existe porque o nome é guardado cifrado e o e-mail só tem hash determinístico: nenhum dos
  /// dois responde busca por prefixo, e sem isso achar alguém de outra empresa exigia saber o
  /// e-mail exato de antemão. O handle é a peça que torna o diretório navegável sem tirar nome
  /// nenhum da criptografia.
  ///
  /// **Não acrescente `@@index([username])` aqui.** O `@unique` acima já cria
  /// `auth_users_username_key`, e o que a busca do diretório usa é o
  /// `auth_users_username_prefix_idx` com `text_pattern_ops`, criado à mão na migração
  /// `20260827160000_add_username` — o Prisma não sabe declarar classe de operador. Um
  /// `@@index` aqui gera um btree comum e faz o `migrate dev` propor derrubar o de prefixo,
  /// desotimizando o `LIKE 'x%'` em que a feature inteira se apoia.
  username              String?        @unique @map("username")
  /// Se o handle aparece na busca entre empresas.
  ///
  /// Separado do handle de propósito: todo mundo precisa de um identificador estável, nem todo
  /// mundo quer ser encontrado. Sem esta coluna, dar handle a alguém seria inscrevê-lo num
  /// diretório sem perguntar.
  usernameDiscoverable  Boolean        @default(true) @map("username_discoverable")
  status                AuthUserStatus @default(active)
  emailVerified         Boolean        @default(false) @map("email_verified")
  /// Idioma da interface, em BCP-47 (`pt-BR`, `en-US`, `es-419`).
  ///
  /// Mora aqui, e não no navegador, porque o servidor precisa dele: e-mail, notificação e PDF
  /// de assinatura são renderizados sem browser nenhum por perto. Guardado só no cliente, o
  /// app falaria inglês na tela e português na caixa de entrada da mesma pessoa.
  ///
  /// Idioma não é país: quem tem CPF pode preferir ler em inglês e continua tendo CPF. Quem
  /// decide validação fiscal e formato de telefone é `AuthTenant.country`.
  locale                String         @default("pt-BR") @db.VarChar(10)
  /// Fuso IANA (`America/Sao_Paulo`). Nulo = usar o do navegador.
  ///
  /// Sem ele, um evento de auditoria muda de dia conforme quem o abre — o que é ruim num
  /// registro cuja razão de existir é dizer quando algo aconteceu.
  timeZone              String?        @map("time_zone") @db.VarChar(64)
  lastLoginAt           DateTime?      @map("last_login_at")
  anonymizedAt          DateTime?      @map("anonymized_at")
  avatarStorageProvider String?        @map("avatar_storage_provider")
  avatarObjectKey       String?        @map("avatar_object_key")
  avatarContentType     String?        @map("avatar_content_type")
  avatarVersion         Int            @default(0) @map("avatar_version")
  avatarUpdatedAt       DateTime?      @map("avatar_updated_at")
  avatarSize            Int?           @map("avatar_size")
  avatarStatus          String?        @map("avatar_status")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  credential         AuthCredential?
  sessions           AuthSession[]
  passwordResets     AuthPasswordReset[]
  emailVerifications AuthEmailVerification[]
  emailChanges       AuthEmailChange[]
  auditLogs          AuthAuditLog[]
  memberships        AuthMembership[]
  deletionRequests   AuthAccountDeletionRequest[]
  termsAcceptances   AuthTermsAcceptance[]
  oauthAccounts      AuthOAuthAccount[]

  invitesSent     AuthInvite[] @relation("InviteInvitedByUser")
  invitesAccepted AuthInvite[] @relation("InviteAcceptedByUser")

  @@index([whatsappLookupHash])
  @@index([status])
  @@map("auth_users")
}

model AuthCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  sessionTokenHash   String    @unique @map("session_token_hash")
  activeMembershipId String?   @map("active_membership_id") @db.Uuid
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  ipHash             String?   @map("ip_hash")
  userAgentHash      String?   @map("user_agent_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             AuthUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership AuthMembership? @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeMembershipId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuthPasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_password_resets")
}

/// Confirmação do e-mail com que a conta nasceu.
///
/// Guarda os dois formatos do mesmo segredo: `codeHash` para os 6 dígitos que a pessoa digita, e
/// `tokenHash` para o link do mesmo e-mail. Um código curto só é seguro com teto de tentativas, e
/// é por isso que `attempts` mora na linha e não num contador em memória: reiniciar o processo não
/// pode devolver tentativas a quem está adivinhando.
model AuthEmailVerification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  codeHash       String    @map("code_hash")
  tokenHash      String    @unique @map("token_hash")
  attempts       Int       @default(0)
  /// Prazo do código. Curto, porque seis dígitos são um segredo pequeno.
  expiresAt      DateTime  @map("expires_at")
  /// Prazo do link, e ele é bem mais longo.
  ///
  /// Dois prazos na mesma linha porque os dois segredos não valem o mesmo: 32 bytes aleatórios
  /// não se adivinham, e quem lê o e-mail horas depois no celular ainda deve conseguir clicar.
  /// Um prazo só forçaria escolher entre um código frouxo e um link inútil.
  tokenExpiresAt DateTime  @map("token_expires_at")
  usedAt         DateTime? @map("used_at")
  /// Quando o e-mail saiu — é daqui que o teto de reenvio se mede.
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("auth_email_verifications")
}

/// Troca de endereço, com as mesmas duas formas do mesmo segredo da confirmação de cadastro —
/// ver `AuthEmailVerification`, de onde estas colunas foram espelhadas.
model AuthEmailChange {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  newEmailEncrypted  String    @map("new_email_encrypted")
  newEmailLookupHash String    @map("new_email_lookup_hash")
  codeHash           String    @map("code_hash")
  tokenHash          String    @unique @map("token_hash")
  attempts           Int       @default(0)
  /// Prazo do código.
  expiresAt          DateTime  @map("expires_at")
  /// Prazo do link.
  tokenExpiresAt     DateTime  @map("token_expires_at")
  usedAt             DateTime? @map("used_at")
  /// Quando o e-mail saiu — é daqui que o teto de reenvio se mede.
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([newEmailLookupHash])
  @@map("auth_email_changes")
}

model AuthLoginAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  emailLookupHash String?  @map("email_lookup_hash")
  ipHash          String?  @map("ip_hash")
  success         Boolean
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([emailLookupHash])
  @@index([ipHash])
  @@index([createdAt])
  @@map("auth_login_attempts")
}

model AuthAuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  actorMembershipId  String?  @map("actor_membership_id") @db.Uuid
  targetUserId       String?  @map("target_user_id") @db.Uuid
  targetMembershipId String?  @map("target_membership_id") @db.Uuid
  tenantTextId       String?  @map("tenant_text_id")
  action             String
  ipHash             String?  @map("ip_hash")
  userAgentHash      String?  @map("user_agent_hash")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  user AuthUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([tenantTextId])
  @@index([targetMembershipId])
  @@index([createdAt])
  @@map("auth_audit_logs")
}

model AuthTenant {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @unique @map("tenant_id")
  tenantType            TenantType   @map("tenant_type")
  displayNameEncrypted  String?      @map("display_name_encrypted")
  displayNameLookupHash String?      @map("display_name_lookup_hash")
  slug                  String?      @unique
  /**
   * ISO 3166-1 alpha-2 (ex.: BR, PY, US, ES). Determina validação de doc fiscal e formato de telefone no cadastro.
   */
  country               String?      @map("country") @db.VarChar(2)
  /// Idioma padrão da organização: o que vale para quem ainda não escolheu o seu, e o que
  /// decide a língua do convite antes de o convidado ter conta.
  ///
  /// Separado de `country` de propósito — uma empresa no México pode operar em inglês.
  defaultLocale         String       @default("pt-BR") @map("default_locale") @db.VarChar(10)
  taxIdType             String?      @map("tax_id_type")
  taxIdMasked           String?      @map("tax_id_masked")
  taxIdHash             String?      @map("tax_id_hash")
  status                TenantStatus @default(pending)
  blockedAt             DateTime?    @map("blocked_at")
  blockedByMembershipId String?      @map("blocked_by_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  memberships      AuthMembership[]
  accessGroups     AuthAccessGroup[]
  termsAcceptances AuthTermsAcceptance[]
  invites          AuthInvite[]

  @@index([taxIdHash])
  @@index([status])
  @@index([country])
  @@map("auth_tenants")
}

model AuthMembership {
  id                           String           @id @default(uuid()) @db.Uuid
  userId                       String           @map("user_id") @db.Uuid
  tenantId                     String           @map("tenant_id") @db.Uuid
  status                       MembershipStatus @default(pending)
  requestedJobTitleEncrypted   String?          @map("requested_job_title_encrypted")
  requestedDepartmentEncrypted String?          @map("requested_department_encrypted")
  requestedReasonEncrypted     String?          @map("requested_reason_encrypted")
  approvedByMembershipId       String?          @map("approved_by_membership_id") @db.Uuid
  approvedAt                   DateTime?        @map("approved_at")
  rejectedByMembershipId       String?          @map("rejected_by_membership_id") @db.Uuid
  rejectedAt                   DateTime?        @map("rejected_at")
  rejectedReasonEncrypted      String?          @map("rejected_reason_encrypted")
  blockedByMembershipId        String?          @map("blocked_by_membership_id") @db.Uuid
  blockedAt                    DateTime?        @map("blocked_at")
  removedByMembershipId        String?          @map("removed_by_membership_id") @db.Uuid
  removedAt                    DateTime?        @map("removed_at")
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")

  user                   AuthUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                 AuthTenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                  AuthMembershipRole[]
  accessGroupLinks       AuthMembershipAccessGroup[]
  notificationPreference AuthNotificationPreference?
  activeSessions         AuthSession[]
  termsAcceptances       AuthTermsAcceptance[]

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("auth_memberships")
}

model AuthMembershipRole {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  role         TenantRole
  createdAt    DateTime   @default(now()) @map("created_at")

  membership AuthMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("auth_membership_roles")
}

model AuthAccessGroup {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  groupId               String            @map("group_id")
  nameEncrypted         String            @map("name_encrypted")
  slug                  String
  descriptionEncrypted  String?           @map("description_encrypted")
  status                AccessGroupStatus @default(active)
  deletedAt             DateTime?         @map("deleted_at")
  deletedByMembershipId String?           @map("deleted_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  tenant      AuthTenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberLinks AuthMembershipAccessGroup[]

  @@unique([tenantId, groupId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("auth_access_groups")
}

model AuthMembershipAccessGroup {
  id            String   @id @default(uuid()) @db.Uuid
  membershipId  String   @map("membership_id") @db.Uuid
  accessGroupId String   @map("access_group_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  membership  AuthMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  accessGroup AuthAccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  @@unique([membershipId, accessGroupId])
  @@map("auth_membership_access_groups")
}

model AuthNotificationPreference {
  id                        String   @id @default(uuid()) @db.Uuid
  membershipId              String   @unique @map("membership_id") @db.Uuid
  email                     Boolean  @default(true)
  whatsapp                  Boolean  @default(true)
  documentCreated           Boolean  @default(true) @map("document_created")
  documentUpdated           Boolean  @default(true) @map("document_updated")
  documentRequiresSignature Boolean  @default(true) @map("document_requires_signature")
  accessApproved            Boolean  @default(true) @map("access_approved")
  accessRejected            Boolean  @default(true) @map("access_rejected")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  membership AuthMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("auth_notification_preferences")
}

model AuthAccountDeletionRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("pending")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("auth_account_deletion_requests")
}

model AuthTermsAcceptance {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  membershipId   String?             @map("membership_id") @db.Uuid
  tenantId       String?             @map("tenant_id") @db.Uuid
  flow           TermsAcceptanceFlow
  termsVersion   String              @map("terms_version")
  privacyVersion String?             @map("privacy_version")
  /// Em que idioma o texto aceito estava escrito.
  ///
  /// Termos traduzidos não são o mesmo documento: a redação muda por jurisdição, e provar
  /// consentimento exige saber qual versão a pessoa leu, não só qual número ela tinha.
  locale         String              @default("pt-BR") @db.VarChar(10)
  acceptedAt     DateTime            @default(now()) @map("accepted_at")
  ipAddressHash  String?             @map("ip_address_hash")
  userAgentHash  String?             @map("user_agent_hash")
  createdAt      DateTime            @default(now()) @map("created_at")

  user       AuthUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership AuthMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  tenant     AuthTenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([membershipId])
  @@index([tenantId])
  @@index([flow])
  @@map("auth_terms_acceptances")
}

model AuthOAuthAccount {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  provider         String
  providerSubject  String    @map("provider_subject")
  providerTenantId String?   @map("provider_tenant_id")
  email            String?
  emailVerified    Boolean   @default(false) @map("email_verified")
  displayName      String?   @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  linkedAt         DateTime  @default(now()) @map("linked_at")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@index([provider, email])
  @@map("auth_oauth_accounts")
}

model AuthInvite {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  emailEncrypted        String       @map("email_encrypted")
  emailLookupHash       String       @map("email_lookup_hash")
  firstNameEncrypted    String?      @map("first_name_encrypted")
  lastNameEncrypted     String?      @map("last_name_encrypted")
  invitedByUserId       String       @map("invited_by_user_id") @db.Uuid
  invitedByMembershipId String       @map("invited_by_membership_id") @db.Uuid
  tokenHash             String       @unique @map("token_hash")
  /// Em que língua falar com quem ainda não tem conta.
  ///
  /// O convite é o único e-mail cujo destinatário não tem perfil para consultar. Sem esta
  /// coluna, a saída seria o padrão do sistema — e um fornecedor mexicano receberia em
  /// português o primeiro contato dele com o produto.
  locale                String       @default("pt-BR") @db.VarChar(10)
  status                InviteStatus @default(pending)
  expiresAt             DateTime     @map("expires_at")
  acceptedAt            DateTime?    @map("accepted_at")
  acceptedByUserId      String?      @map("accepted_by_user_id") @db.Uuid
  acceptedMembershipId  String?      @map("accepted_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  tenant         AuthTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser  AuthUser         @relation("InviteInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUser AuthUser?        @relation("InviteAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles          AuthInviteRole[]

  @@index([tenantId, emailLookupHash, status])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("auth_invites")
}

model AuthInviteRole {
  id        String     @id @default(uuid()) @db.Uuid
  inviteId  String     @map("invite_id") @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at")

  invite AuthInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, role])
  @@map("auth_invite_roles")
}
