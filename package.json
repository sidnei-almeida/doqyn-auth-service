{
  "name": "doqyn-auth-service",
  "version": "0.1.0",
  "description": "Serviço mínimo e seguro de autenticação para o DOQYN",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx scripts/ensure-dev-db.ts && tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "dev:seed:demo": "tsx src/demo/demoSeed.ts",
    "dev:seed:all": "SEED_FORCE_PASSWORD_RESET=true tsx src/db/seed.ts && tsx src/demo/demoSeed.ts",
    "db:seed:docker": "node dist/db/seed.js",
    "dev:reset:postgres": "tsx scripts/dev-reset-postgres.ts",
    "audit:db-counts": "tsx scripts/audit-db-counts.ts",
    "audit:auth-health": "tsx scripts/audit-auth-health.ts",
    "audit:auth-storage": "tsx scripts/audit-auth-storage.ts",
    "env:alpha-sync": "node scripts/env-alpha-sync-check.mjs",
    "dev:db": "docker compose up -d postgres-auth",
    "dev:db:status": "docker compose ps postgres-auth",
    "dev:db:logs": "docker compose logs -f postgres-auth",
    "dev:local": "tsx scripts/dev-local.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "deploy:setup": "./scripts/setup-production-env.sh",
    "deploy:production": "./scripts/deploy-production.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.9",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
